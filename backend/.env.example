PORT=3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative name supported by the backend: SUPABASE_SECRET_KEY
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of trusted proxy hops; set only for a controlled reverse proxy.
TRUST_PROXY=0
EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:5173/verificar-correo
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/recuperar
# Optional auth email hook; use the provider's signing secret.
SEND_EMAIL_HOOK_SECRET=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
