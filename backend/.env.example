# Configuración del servidor
# PORT=3000

# Configuración de la base de datos
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cloudbox
# DB_USER=root
# DB_PASSWORD=

# Configuración de autenticación
# JWT_SECRET=

# Configuración de almacenamiento
# UPLOAD_PATH=uploads/

# CloudBox - Variables de entorno
#
# Este archivo sirve como plantilla para que cada integrante
# pueda crear su propio archivo .env.
#
# IMPORTANTE:
# El archivo .env REAL NO debe subirse a GitHub porque contiene
# información privada como contraseñas y claves secretas.
#
# Para trabajar localmente:
# 1. Copiar este archivo.
# 2. Renombrarlo a .env.
# 3. Colocar los valores correspondientes a la computadora local.